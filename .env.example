# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Conventions:
# - Every variable the app reads is listed here, without a value.
# - Variables prefixed with NEXT_PUBLIC_ are sent to the browser: never put a secret in them.
# - All other variables stay on the server.

# Supabase (local stack: run `npx supabase start`, then copy the values from `npx supabase status`).
# Project API URL, e.g. the local "API_URL".
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key: safe in the browser, every request it makes is subject to RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
