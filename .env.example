# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Conventions:
# - Every variable the app reads is listed here, without a value.
# - Variables prefixed with NEXT_PUBLIC_ are sent to the browser: never put a secret in them.
# - All other variables stay on the server.

# Supabase project (Project Settings > API keys). For the local stack, `npx supabase status`
# prints both values (API_URL and PUBLISHABLE_KEY).
# The publishable key is public by design: Row Level Security decides what it can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
